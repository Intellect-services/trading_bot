[flake8]
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    venv310,
    .pytest_cache,
    build,
    dist,
    *.egg-info,
    ./.venv/*,
    ./venv/*,
    ./venv310/*
max-line-length = 100
max-complexity = 10
select = E9,F63,F7,F82
show-source = True
statistics = True
per-file-ignores =
    # Ignore all errors in virtual environment
    .venv/*:*
    venv/*:*
    venv310/*:* 