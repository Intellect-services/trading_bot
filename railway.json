{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && cd src/frontend && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT --workers 4 --timeout 120 --worker-class eventlet --worker-connections 1000 src.app:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthcheckPath": "/health",
  "healthcheckTimeout": 100,
  "rewrites": [
    {
      "source": "/*",
      "destination": "/"
    }
  ]
}
